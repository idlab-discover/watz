diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..f38bcb4
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,35 @@
+cmake_minimum_required(VERSION 3.5)
+project(polybench)
+
+if(NOT CMAKE_BUILD_TYPE)
+  set(CMAKE_BUILD_TYPE Release)
+endif()
+
+set(CMAKE_CXX_FLAGS "-Wall -Wextra")
+set(CMAKE_CXX_FLAGS_DEBUG "-g")
+set(CMAKE_CXX_FLAGS_RELEASE "-O3")
+
+add_compile_definitions(MEDIUM_DATASET)
+
+# add_library(polybench all/all.c)
+add_executable(polybench all/all.c)
+
+## Print run time of each test
+# target_compile_definitions(polybench PUBLIC POLYBENCH_TIME)
+# target_compile_definitions(polybench PRIVATE POLYBENCH_CLOCK_TIMER)
+
+file(GLOB_RECURSE sources CONFIGURE_DEPENDS datamining/*.c linear-algebra/*.c medley/*.c stencils/*.c)
+file(GLOB headers include/*.h)
+
+target_sources(polybench 
+    PUBLIC FILE_SET public_headers TYPE HEADERS BASE_DIRS "all" FILES "all/all.h"
+    PRIVATE
+        "utilities/polybench.c" 
+        ${sources}
+    PRIVATE
+        FILE_SET private_headers
+        TYPE HEADERS
+        BASE_DIRS "utilities" "include"
+        FILES "utilities/polybench.h" ${headers}
+)
+
diff --git a/all/all.c b/all/all.c
new file mode 100644
index 0000000..7b59181
--- /dev/null
+++ b/all/all.c
@@ -0,0 +1,106 @@
+#include <stdio.h>
+#include <time.h>
+
+#include "all.h"
+
+#include "2mm.h"
+#include "3mm.h"
+#include "adi.h"
+#include "atax.h"
+#include "bicg.h"
+#include "cholesky.h"
+#include "correlation.h"
+#include "covariance.h"
+#include "deriche.h"
+#include "doitgen.h"
+#include "durbin.h"
+#include "fdtd-2d.h"
+#include "floyd-warshall.h"
+#include "gemm.h"
+#include "gemver.h"
+#include "gesummv.h"
+#include "gramschmidt.h"
+#include "heat-3d.h"
+#include "jacobi-1d.h"
+#include "jacobi-2d.h"
+#include "lu.h"
+#include "ludcmp.h"
+#include "mvt.h"
+#include "seidel-2d.h"
+#include "symm.h"
+#include "syr2k.h"
+#include "syrk.h"
+#include "trisolv.h"
+#include "trmm.h"
+
+#define test(func)                                                             \
+  if ((res = func(argc, argv)) != 0)                                           \
+    printf("Error executing: %d\n", res);
+
+#define timespec_diff(a, b, result)                                            \
+  do {                                                                         \
+    (result)->tv_sec = (a)->tv_sec - (b)->tv_sec;                              \
+    (result)->tv_nsec = (a)->tv_nsec - (b)->tv_nsec;                           \
+    if ((result)->tv_nsec < 0) {                                               \
+      --(result)->tv_sec;                                                      \
+      (result)->tv_nsec += 1000000000;                                         \
+    }                                                                          \
+  } while (0)
+
+#define timespec_to_micro(t) t.tv_sec * 1000 * 1000 + t.tv_nsec / 1000
+
+#define BENCHMARK_START(X)                                                     \
+  struct timespec start_##X, end_##X, X;                                       \
+  clock_gettime(CLOCK_MONOTONIC, &start_##X)
+
+#define BENCHMARK_STOP(X)                                                      \
+  do {                                                                         \
+    clock_gettime(CLOCK_MONOTONIC, &end_##X);                                  \
+    timespec_diff(&end_##X, &start_##X, &X);                                   \
+  } while (0)
+
+int main(int argc, char *argv[]) {
+  // int all(char *benchmark_buffer, int benchmark_buffer_size) {
+  // int argc = 0;
+  // char *argv[] = {NULL};
+  int res = 0;
+
+  BENCHMARK_START(nanos);
+
+  test(correlation);
+  test(covariance);
+  test(gemm);
+  test(gemver);
+  test(gesummv);
+  test(symm);
+  test(syr2k);
+  test(two_mm);
+  test(three_mm);
+  test(atax);
+  test(bicg);
+  test(doitgen);
+  test(mvt);
+  test(cholesky);
+  test(durbin);
+  test(gramschmidt);
+  test(lu);
+  test(ludcmp);
+  test(trisolv);
+  test(deriche);
+  test(floyd_warshall);
+  // test(nussinov);
+  test(adi);
+  test(fdtd_2d);
+  test(heat_3d);
+  test(jacobi_1d);
+  test(jacobi_2d);
+  test(seidel_2d);
+
+  BENCHMARK_STOP(nanos);
+
+  printf("%lld\n", timespec_to_micro(nanos));
+  // snprintf(benchmark_buffer, benchmark_buffer_size, "%ld\n",
+  //          timespec_to_micro(nanos));
+
+  return res;
+}
